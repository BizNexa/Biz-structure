{
  "name": "income-tax-calculator-ty2026-27",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indian income tax calculator, Tax Year 2026-27 (Income-tax Act, 2025 as amended by Finance Act, 2026). Computation aid, not advice.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:literals": "node scripts/lint-literals.mjs",
    "smoke": "node scripts/smoke.ts",
    "test": "node --test tests/engine.test.ts tests/properties.test.ts",
    "check": "npm run typecheck && npm run lint:literals && npm run smoke && npm test && npm run build",
    "render:review": "node scripts/render-review.cjs .",
    "render:cases": "node scripts/render-cases.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "build:site": "npm run check && vite build --outDir ../income-tax-calculator --emptyOutDir"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.6"
  }
}
