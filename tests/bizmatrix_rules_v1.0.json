{
  "version": "1.0",
  "verified_as_of": "6 Nov 2026",
  "entities": [
    {
      "id": "PROP",
      "name": "Sole Proprietorship"
    },
    {
      "id": "PF",
      "name": "Partnership Firm"
    },
    {
      "id": "LLP",
      "name": "Limited Liability Partnership"
    },
    {
      "id": "OPC",
      "name": "One Person Company"
    },
    {
      "id": "PVT",
      "name": "Private Limited Company"
    },
    {
      "id": "PUB",
      "name": "Public Limited Company"
    },
    {
      "id": "S8",
      "name": "Section 8 Company"
    }
  ],
  "factors": [
    {
      "id": "F09",
      "name": "Liability risk of the activity",
      "weight": 20,
      "basis": "LAW+JDG",
      "input": "liability"
    },
    {
      "id": "F06",
      "name": "Funding route",
      "weight": 15,
      "basis": "MKT",
      "input": "funding"
    },
    {
      "id": "F10",
      "name": "Tax on profit (profit level x extraction)",
      "weight": 15,
      "basis": "LAW",
      "input": "profit_level+extraction"
    },
    {
      "id": "F14",
      "name": "Compliance appetite",
      "weight": 15,
      "basis": "JDG",
      "input": "compliance"
    },
    {
      "id": "F15",
      "name": "Credibility with banks, tenders, large clients",
      "weight": 10,
      "basis": "MKT",
      "input": "credibility"
    },
    {
      "id": "F16",
      "name": "Exit / succession plan",
      "weight": 10,
      "basis": "LAW+MKT",
      "input": "exit"
    },
    {
      "id": "F05",
      "name": "Foreign money (scored part)",
      "weight": 5,
      "basis": "LAW+REG",
      "input": "foreign"
    },
    {
      "id": "F19",
      "name": "Startup India (DPIIT) eligibility value",
      "weight": 5,
      "basis": "REG",
      "input": "business"
    },
    {
      "id": "F20",
      "name": "Formation cost and speed",
      "weight": 5,
      "basis": "MKT",
      "input": "(always)"
    }
  ],
  "rules": [
    {
      "id": "R-001",
      "if": "objective == nonprofit",
      "then": "eligible = {S8}",
      "basis": "LAW",
      "cite": "Companies Act 2013 s.8(1)",
      "plain": "A charitable / not-for-profit objective can only be served by a Section 8 company within this tool's scope."
    },
    {
      "id": "R-002",
      "if": "objective == profit",
      "then": "exclude S8",
      "basis": "LAW",
      "cite": "Companies Act 2013 s.8(1)(b)-(c)",
      "plain": "A Section 8 company must apply profits to its objects and cannot pay dividends."
    },
    {
      "id": "R-003",
      "if": "founders == one",
      "then": "exclude PF, LLP, PVT, PUB, S8",
      "basis": "LAW",
      "cite": "Partnership Act 1932 s.4; LLP Act 2008 s.6(1); Companies Act s.3(1)",
      "plain": "Partnership and LLP need at least 2 partners; Pvt Ltd and Section 8 (private) need 2 members; Public needs 7."
    },
    {
      "id": "R-004",
      "if": "founders != one",
      "then": "exclude PROP, OPC",
      "basis": "LAW",
      "cite": "Companies Act s.2(62), s.3(1)(c)",
      "plain": "A proprietorship has one owner; an OPC has exactly one member."
    },
    {
      "id": "R-005",
      "if": "founders in {one, two_to_six}",
      "then": "exclude PUB (flag: possible if 7 members can be brought in)",
      "basis": "LAW",
      "cite": "Companies Act s.3(1)(a), s.149(1)(a)",
      "plain": "A public company needs at least 7 members and 3 directors."
    },
    {
      "id": "R-006",
      "if": "max_owners in {51_200, over_200}",
      "then": "exclude PF",
      "basis": "LAW",
      "cite": "Companies Act s.464; Companies (Misc.) Rules 2014 r.10",
      "plain": "A partnership of more than 50 persons is prohibited."
    },
    {
      "id": "R-007",
      "if": "max_owners == over_200",
      "then": "exclude PVT, OPC",
      "basis": "LAW",
      "cite": "Companies Act s.2(68)(ii)",
      "plain": "A private company is capped at 200 members (excluding employee/ex-employee members)."
    },
    {
      "id": "R-008",
      "if": "residency == foreign_national",
      "then": "exclude OPC; REVIEW for PROP, PF",
      "basis": "LAW",
      "cite": "Companies (Incorporation) Rules 2014 r.3(1); FEMA (Non-debt Instruments) Rules 2019",
      "plain": "Only an Indian citizen can be an OPC member; foreign nationals face FEMA limits on proprietorships and firms."
    },
    {
      "id": "R-009",
      "if": "foreign == investment",
      "then": "exclude PROP, PF, OPC; flag LLP sector check",
      "basis": "LAW/REG",
      "cite": "FEMA NDI Rules 2019; Consolidated FDI Policy; Companies (Incorporation) Rules r.3",
      "plain": "FDI is not permitted in proprietorships and firms; an OPC cannot have a foreign shareholder."
    },
    {
      "id": "R-010",
      "if": "foreign == contribution",
      "then": "REVIEW (FCRA)",
      "basis": "LAW",
      "cite": "Foreign Contribution (Regulation) Act 2010 s.11-12",
      "plain": "Foreign donations need FCRA registration or prior permission; new entities usually cannot register at once."
    },
    {
      "id": "R-011",
      "if": "funding == public",
      "then": "eligible for-profit = {PUB}",
      "basis": "LAW",
      "cite": "Companies Act s.23(1); s.2(68)(iii)",
      "plain": "Only a public company can invite the public to subscribe to securities."
    },
    {
      "id": "R-012",
      "if": "funding == vc",
      "then": "exclude PROP, PF, OPC",
      "basis": "LAW",
      "cite": "Companies Act s.2(62), s.43; Partnership Act s.4",
      "plain": "Proprietorships and firms cannot issue equity; an OPC cannot add a second member without converting."
    },
    {
      "id": "R-013",
      "if": "esop == yes",
      "then": "exclude PROP, PF, LLP, OPC",
      "basis": "LAW",
      "cite": "Companies Act s.2(37), s.62(1)(b)",
      "plain": "Statutory employee stock options exist only for companies with more than one member."
    },
    {
      "id": "R-014",
      "if": "profession == ca_cs_cma",
      "then": "exclude OPC, PVT, PUB",
      "basis": "LAW/REG",
      "cite": "Chartered Accountants Act 1949 s.2(2), s.7, s.25; parallel CS & CMA Acts",
      "plain": "Members in practice may practise as individuals, firms or LLPs, not through companies."
    },
    {
      "id": "R-015",
      "if": "profession == advocate",
      "then": "exclude OPC, PVT, PUB; LLP = grey area",
      "basis": "REG",
      "cite": "Advocates Act 1961; Bar Council of India Rules Part VI",
      "plain": "Advocates cannot practise law through a company; law-firm LLPs exist but are State Bar Council-dependent."
    },
    {
      "id": "R-016",
      "if": "profession == other_regulated",
      "then": "REVIEW",
      "basis": "REG",
      "cite": "Relevant professional council regulations",
      "plain": "Doctors, architects and other regulated professionals must check council rules before choosing a corporate form."
    },
    {
      "id": "R-017",
      "if": "activity == nbfc",
      "then": "eligible = {PVT, PUB}",
      "basis": "LAW",
      "cite": "RBI Act 1934 s.45-IA, s.45-I(f)",
      "plain": "Only a company can apply for NBFC registration."
    },
    {
      "id": "R-018",
      "if": "activity == insurance",
      "then": "eligible = {PUB}; REVIEW",
      "basis": "LAW",
      "cite": "Insurance Act 1938 s.2(7A), s.2C",
      "plain": "An Indian insurer must be a public company (subject to IRDAI)."
    },
    {
      "id": "R-019",
      "if": "objective == nonprofit and founders == one",
      "then": "NO ELIGIBLE STRUCTURE in scope",
      "basis": "LAW",
      "cite": "Companies (Incorporation) Rules 2014 r.3(6) [OPC cannot be a s.8 company]; s.3(1)",
      "plain": "A one-person charity cannot be a Section 8 company; consider a trust (out of scope)."
    },
    {
      "id": "R-020",
      "if": "residency in {nri, foreign_national} and all founders non-resident",
      "then": "REVIEW: resident director / designated partner needed",
      "basis": "LAW",
      "cite": "Companies Act s.149(3); LLP Act s.7(1)",
      "plain": "Every company needs one director resident 182+ days in the FY; every LLP needs one resident designated partner."
    },
    {
      "id": "R-021",
      "if": "activity == other_licensed or sector in restricted-FDI list and foreign == investment",
      "then": "REVIEW",
      "basis": "REG",
      "cite": "Consolidated FDI Policy (DPIIT)",
      "plain": "Sector licensing and FDI caps can override entity choice."
    },
    {
      "id": "R-023",
      "if": "residency == nri and PROP or PF eligible",
      "then": "REVIEW (FEMA)",
      "basis": "LAW",
      "cite": "FEMA (Non-debt Instruments) Rules 2019 (NRI investment in firms/proprietary concerns)",
      "plain": "An NRI may invest in a firm or proprietary concern only on the conditions FEMA allows (generally non-repatriation); confirm before choosing."
    },
    {
      "id": "R-022",
      "if": "objective == nonprofit and founders == seven_plus",
      "then": "S8 may be private or public type; no change",
      "basis": "LAW",
      "cite": "Companies Act s.8(1)",
      "plain": "Section 8 can be formed as a private (2+) or public (7+) company."
    }
  ],
