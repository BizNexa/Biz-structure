PORT=3000
NODE_ENV=development
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
FRONTEND_URL=http://localhost:3000/
FRONTEND_ORIGINS=http://localhost:3000,https://bizmatrix.in,https://www.bizmatrix.in
# Set to 1 only when your hosting provider has exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# These paths must live on a persistent PRIVATE disk on the backend host.
DATA_DIR=./data
PREMIUM_DIR=./private
# Optional stable secret (at least 32 characters). If empty, a random secret
# is generated in DATA_DIR/app-secret.key; persist that file with the database.
APP_SECRET=
